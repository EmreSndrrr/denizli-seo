  "narrative": {
    "northStar": "The Search Lens",
    "overview": "A dark graphite room with one fixed three.js stage (chrome magnifier, link graph, dust) behind transparent chapters; the backdrop turns to search-results paper for the results chapter and back. Yellow is the one voice of action; blue is the web and the visitor's own district.",
    "keyCharacteristics": [
      "Dark ink ground, one paper chapter",
      "Signal yellow for every action; blue only for links, web, home district",
      "Archivo plus one Instrument Serif italic word per heading",
      "Pill controls, glass cards with 1px light line",
      "Stage degrades: reduced motion = still layout, no WebGL = page unchanged"
    ],
    "rules": [
      {
        "name": "The One Action Rule",
        "body": "Yellow means act or selected and nothing else. Blue never fills a button.",
        "section": "colors"
      },
      {
        "name": "The Paper Chapter Rule",
        "body": "Only the results chapter sits on paper; there the accent word is ink with a yellow highlighter underline.",
        "section": "colors"
      },
      {
        "name": "The Labelled Sample Rule",
        "body": "Any illustrative ranking, number or result is labelled Örnek gösterim.",
        "section": "colors"
      },
      {
        "name": "The Two Families Rule",
        "body": "Archivo plus Instrument Serif italic; no third family, no monospace.",
        "section": "typography"
      },
      {
        "name": "The One Italic Rule",
        "body": "One em accent word per heading.",
        "section": "typography"
      },
      {
        "name": "The 13px Floor Rule",
        "body": "Nothing renders under 13px.",
        "section": "typography"
      },
      {
        "name": "The Two Lines Rule",
        "body": "Headings run at most two lines.",
        "section": "typography"
      },
      {
        "name": "The No Eyebrow Rule",
        "body": "No kicker above a heading.",
        "section": "typography"
      },
      {
        "name": "The Glass Over Stage Rule",
        "body": "Cards are translucent so the stage shows through.",
        "section": "elevation"
      },
      {
        "name": "The Soft Shadow Rule",
        "body": "Large, offset-down, negative-spread black shadows; no hard offset shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do label the primary action Ücretsiz SEO analizi iste (opens WhatsApp with a written message) and use the brand name Denizli SEO.",
      "Do label every illustrative figure or result Örnek gösterim.",
      "Do keep the © OpenStreetMap credit on the map and in the footer.",
      "Do use only real content: six real project screenshots and Google rating 5,0 from 28 reviews.",
      "Do keep headings to two lines with one serif accent word.",
      "Do keep a 3px yellow focus ring and 44px minimum targets.",
      "Do degrade the stage: reduced motion gives a still layout with a static frame; no WebGL leaves the page unchanged."
    ],
    "donts": [
      "Don't invent testimonials, logos, statistics, case studies, awards or guarantees.",
      "Don't add a third font, monospace, or eyebrow text.",
      "Don't set text below 13px.",
      "Don't use blue as a button color or yellow text on the paper chapter.",
      "Don't put opaque slabs over the stage where a glass card fits."
