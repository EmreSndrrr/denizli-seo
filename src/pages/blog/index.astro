---
import BlogListing from '../../components/BlogListing.astro';
import { loadBlog } from '../../data/blog';

const { topics, pages, pageOf } = await loadBlog();
const lead = 'Denizli’deki işletmeler için SEO, Google İşletme Profili, site hızı ve backlink üzerine kısa, kaynaklı ve uygulanabilir yazılar.';
---
<BlogListing
  title="Blog: SEO ve Google Haritalar Notları | Denizli SEO"
  description={lead}
  h1={['Arama', 'üzerine notlar.']}
  lead={lead}
  posts={pageOf(1)}
  topics={topics}
  page={1}
  pages={pages}
/>
