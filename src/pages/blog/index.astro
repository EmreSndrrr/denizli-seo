---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Serp from '../../components/Serp.astro';
import PageHead from '../../components/PageHead.astro';
import Contact from '../../components/Contact.astro';
import Work from '../../components/Work.astro';
import Icon from '../../components/Icon.astro';
import { SITE, WA_ANALYSIS, CTA_LABEL } from '../../data/site';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const title = 'Blog: SEO ve Google Haritalar Notları | Denizli SEO';
const description = 'Denizli’deki işletmeler için SEO, Google İşletme Profili ve site hızı üzerine kısa, uygulanabilir yazılar.';
const url = `${SITE.url}/blog/`;
const jsonld = [
  {
    '@type': 'Blog',
    '@id': `${url}#blog`,
    url,
    name: 'Denizli SEO blog',
    publisher: { '@id': `${SITE.url}/#isletme` },
    blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${SITE.url}/blog/${p.id}/`, datePublished: p.data.date.toISOString() })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: url },
    ],
  },
];
---
<Base title={title} description={description} jsonld={jsonld}>
  <PageHead crumbs={[{ href: '/', label: 'Ana sayfa' }, { label: 'Blog' }]} h1={['Arama', 'üzerine notlar.']} lead="Denizli’deki işletmeler için SEO, Google İşletme Profili ve site hızı üzerine kısa, uygulanabilir yazılar.">
    <Fragment slot="acts">
      <a class="button" href={WA_ANALYSIS} rel="noopener">{CTA_LABEL}<Icon name="arrow" size={18} /></a>
      <a class="button button--outline" href="#yazilar">{posts.length} yazıyı okuyun</a>
    </Fragment>
    <div class="pfrag"><Serp queries={['google işletme profili nasıl doldurulur', 'seo ne kadar sürede sonuç verir', 'denizli kuyumcu']} label="Örnek görünüm." /></div>
  </PageHead>

  <section class="sec band band--white" aria-labelledby="yazilar"><div class="wrap posts">
    <h2 id="yazilar" data-reveal>Yazılar</h2>
    <ul>
      {posts.map((post, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a href={`/blog/${post.id}/`}>
            <span class="posts__title">{post.data.title}</span>
            <span class="posts__text">{post.data.description}</span>
            <span class="posts__go"><time class="small muted" datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time><span>Okuyun <Icon name="arrow" size={16} /></span></span>
          </a>
        </li>
      ))}
    </ul>
  </div></section>

  <Work title="Bu notları yazan ekibin işleri" names={['Denizli Kuyumcu', 'Elea Premium Stay', 'Bilgi Dem Akademi', 'Jarkotech']} />

  <Contact />
</Base>
