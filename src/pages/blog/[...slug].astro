---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Chat from '../../components/home/Chat.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../data/site';
import { serviceBySlug } from '../../data/services';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const byDate = (a: typeof post, b: typeof post) => b.data.date.valueOf() - a.data.date.valueOf();
const all = (await getCollection('blog')).filter((p) => p.id !== post.id);
// two more reads: same topic first, then the newest
const others = [...all.filter((p) => p.data.service === post.data.service).sort(byDate), ...all.filter((p) => p.data.service !== post.data.service).sort(byDate)].slice(0, 2);
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}/`;
const fmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const service = post.data.service ? serviceBySlug(post.data.service) : undefined;
const published = post.data.date.toISOString();
const updated = post.data.updated;
const modified = (updated ?? post.data.date).toISOString();
// the brand follows the title only while the whole <title> stays within what a results page shows (about 60 characters)
const pageTitle = `${post.data.title} | ${SITE.name}`.length <= 60 ? `${post.data.title} | ${SITE.name}` : post.data.title;
const cover = `/blog/${post.id}.jpg`;
const share = `/og/blog-${post.id}.jpg`;

const jsonld = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#yazi`,
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: published,
    dateModified: modified,
    inLanguage: 'tr-TR',
    image: [{ '@type': 'ImageObject', url: `${SITE.url}${share}`, width: 1200, height: 630, caption: post.data.imageAlt }],
    author: { '@id': `${SITE.url}/#isletme` },
    publisher: { '@id': `${SITE.url}/#isletme` },
    isPartOf: { '@type': 'Blog', '@id': `${SITE.url}/blog/#blog` },
    wordCount: words,
    ...(service ? { about: { '@type': 'Service', name: service.name, url: `${SITE.url}/${service.slug}/` } } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Page title={pageTitle} description={post.data.description} jsonld={jsonld} type="article" published={published} modified={modified} image={share} imageAlt={post.data.imageAlt}>
  <section class="banner-sec">
    <div class="wrap">
      <div class="banner">
        <nav class="crumbs" aria-label="Sayfa yolu"><a href="/">Ana sayfa</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span aria-current="page">Yazı</span></nav>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <p class="article-meta">
          <span><Icon name="plan" size={16} />Yayın: <time datetime={published}>{fmt.format(post.data.date)}</time></span>
          {updated && <span>Güncellendi: <time datetime={modified}>{fmt.format(updated)}</time></span>}
          <span>{minutes} dakikalık okuma</span>
        </p>
      </div>
    </div>
  </section>

  <figure class="article-visual wrap">
    <img class="article-cover" src={cover} width="1200" height="630" alt={post.data.imageAlt} fetchpriority="high" decoding="async" />
    <figcaption>Denizli SEO için çizilmiş özgün görsel.</figcaption>
  </figure>

  <article class="article-body" aria-label={post.data.title}>
    <div class="prose">
      <Content />
    </div>
    <aside class="byline" aria-label="Yazı hakkında">
      <span class="byline-mark" aria-hidden="true"><Icon name="user" size={22} /></span>
      <p>
        <b>Denizli SEO</b>, <a href={SITE.parent.url} rel="noopener">{SITE.parent.name}</a>’ın SEO markasıdır; içeriklerden kurucu <a href="/hakkimizda/">{SITE.person}</a> sorumludur.
        Yazıların kaynakları sayfanın sonunda verilir; ayrıntı için <a href="/editoryal-ilkeler/">editoryal ilkelerimize</a> bakın.
      </p>
    </aside>
  </article>

  <section class="rel-sec" aria-labelledby="devami">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h2" id="devami">Devamını <em>okuyun</em></h2>
      </div>
      <div class="rel-grid">
        {others.map((o) => (
          <a class="rel-card reveal" href={`/blog/${o.id}/`}><h3>{o.data.title}</h3><p>{o.data.description}</p><span class="go">Okuyun<Icon name="arrow" size={16} /></span></a>
        ))}
        {service && (
          <a class="rel-card reveal" href={`/${service.slug}/`} style="--tone:var(--orange);--tone-text:var(--orange-text)"><h3>İlgili hizmet: {service.name}</h3><p>{service.lead}</p><span class="go">İnceleyin<Icon name="arrow" size={16} /></span></a>
        )}
      </div>
    </div>
  </section>

  <Chat />
</Page>
