---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Banner from '../../components/home/Banner.astro';
import SerpMock from '../../components/home/SerpMock.astro';
import ReportChart from '../../components/home/ReportChart.astro';
import Chat from '../../components/home/Chat.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../data/site';
import { serviceBySlug } from '../../data/services';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const others = (await getCollection('blog')).filter((p) => p.id !== post.id).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}/`;
const fmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const service = post.data.service ? serviceBySlug(post.data.service) : undefined;
const published = post.data.date.toISOString();
const modified = (post.data.updated ?? post.data.date).toISOString();

const jsonld = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#yazi`,
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: published,
    dateModified: modified,
    inLanguage: 'tr-TR',
    image: `${SITE.url}/og/denizli-seo.jpg`,
    author: { '@type': 'Organization', '@id': `${SITE.url}/#isletme`, name: SITE.name },
    publisher: { '@id': `${SITE.url}/#isletme` },
    wordCount: words,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Page title={`${post.data.title} | Denizli SEO`} description={post.data.description} jsonld={jsonld} type="article" published={published} modified={modified}>
  <section class="banner-sec">
    <div class="wrap">
      <div class="banner">
        <nav class="crumbs" aria-label="Sayfa yolu"><a href="/">Ana sayfa</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span aria-current="page">Yazı</span></nav>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <p class="article-meta"><span><Icon name="plan" size={16} /><time datetime={published}>{fmt.format(post.data.date)}</time></span><span>{minutes} dakikalık okuma</span></p>
      </div>
    </div>
  </section>

  <div class="article-visual wrap">
    <div class="frag reveal">
      {post.data.visual === 'serp' ? <SerpMock label="Örnek görünüm." /> : <div class="vit"><p class="vit-head">Örnek rapor: altı ayda ortalama sıra</p><ReportChart /></div>}
    </div>
  </div>

  <article class="article-body" aria-label={post.data.title}>
    <div class="prose">
      <Content />
    </div>
  </article>

  <section class="rel-sec" aria-labelledby="devami">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h2" id="devami">Devamını <em>okuyun</em></h2>
      </div>
      <div class="rel-grid">
        {others.map((o) => (
          <a class="rel-card reveal" href={`/blog/${o.id}/`}><h3>{o.data.title}</h3><p>{o.data.description}</p><span class="go">Okuyun<Icon name="arrow" size={16} /></span></a>
        ))}
        {service && (
          <a class="rel-card reveal" href={`/${service.slug}/`} style="--tone:var(--orange);--tone-text:var(--orange-text)"><h3>İlgili hizmet: {service.name}</h3><p>{service.lead}</p><span class="go">İnceleyin<Icon name="arrow" size={16} /></span></a>
        )}
      </div>
    </div>
  </section>

  <Chat />
</Page>
