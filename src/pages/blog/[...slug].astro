---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Chat from '../../components/home/Chat.astro';
import Icon from '../../components/Icon.astro';
import { SITE, WA_ANALYSIS, CTA_LABEL } from '../../data/site';
import { serviceBySlug } from '../../data/services';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const byDate = (a: typeof post, b: typeof post) => b.data.date.valueOf() - a.data.date.valueOf();
const all = (await getCollection('blog')).filter((p) => p.id !== post.id);
// four more reads: same topic first, then the newest
const others = [...all.filter((p) => p.data.service === post.data.service).sort(byDate), ...all.filter((p) => p.data.service !== post.data.service).sort(byDate)].slice(0, 4);
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}/`;
const fmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const service = post.data.service ? serviceBySlug(post.data.service) : undefined;
const published = post.data.date.toISOString();
const updated = post.data.updated;
const modified = (updated ?? post.data.date).toISOString();
// the brand follows the title only while the whole <title> stays within what a results page shows (about 60 characters)
const pageTitle = `${post.data.title} | ${SITE.name}`.length <= 60 ? `${post.data.title} | ${SITE.name}` : post.data.title;
const category = service?.short ?? 'SEO';
const cover = `/blog/${post.id}.jpg`;
const share = `/og/blog-${post.id}.jpg`;

const jsonld = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#yazi`,
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: published,
    dateModified: modified,
    inLanguage: 'tr-TR',
    image: [{ '@type': 'ImageObject', url: `${SITE.url}${share}`, width: 1200, height: 630, caption: post.data.imageAlt }],
    author: { '@id': SITE.personId },
    articleSection: category,
    publisher: { '@id': `${SITE.url}/#isletme` },
    isPartOf: { '@type': 'Blog', '@id': `${SITE.url}/blog/#blog` },
    wordCount: words,
    ...(service ? { about: { '@type': 'Service', name: service.name, url: `${SITE.url}/${service.slug}/` } } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: category },
    ],
  },
];
---
<Page title={pageTitle} description={post.data.description} jsonld={jsonld} type="article" published={published} modified={modified} section={category} authorUrl={`${SITE.url}/hakkimizda/`} image={share} imageAlt={post.data.imageAlt}>
  <section class="banner-sec">
    <div class="wrap">
      <div class="banner">
        <nav class="crumbs" aria-label="Sayfa yolu"><a href="/">Ana sayfa</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span aria-current="page">{category}</span></nav>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-meta">
          <span><Icon name="user" size={16} /><span>Yazan: <a href="/hakkimizda/">{SITE.person}</a>, Kurucu</span></span>
          <span><Icon name="plan" size={16} />Yayın: <time datetime={published}>{fmt.format(post.data.date)}</time></span>
          {updated && <span>Güncellendi: <time datetime={modified}>{fmt.format(updated)}</time></span>}
        </p>
        <div class="banner-cta"><a class="btn btn-solid" href="/iletisim/">Hizmet almak için iletişime geçin<Icon name="arrow" size={20} /></a></div>
      </div>
    </div>
  </section>

  <figure class="article-visual wrap">
    <img class="article-cover" src={cover} width="1200" height="630" alt={post.data.imageAlt} fetchpriority="high" decoding="async" />
  </figure>

  <article class="article-body" aria-label={post.data.title}>
    <div class="prose">
      <Content />
    </div>
    <aside class="byline" aria-label="Yazar">
      <span class="byline-mark" aria-hidden="true"><Icon name="user" size={22} /></span>
      <p>
        <b>Yazar: <a href="/hakkimizda/">{SITE.person}</a></b>, Kurucu, <a href={SITE.parent.url} rel="noopener">{SITE.parent.name}</a>.
        Denizli’de web tasarım, SEO ve reklam çalışmalarını tek ekipte yürüten ajansın kurucusu; Denizli SEO bu ajansın SEO markasıdır. Yazıların kaynakları sayfanın sonunda verilir; ayrıntı için <a href="/editoryal-ilkeler/">editoryal ilkelerimize</a> bakın.
      </p>
    </aside>
    <section class="post-cta" aria-labelledby="yazi-cta">
      <h2 id="yazi-cta">Hizmet almak için iletişime geçin</h2>
      <p>Bu yazıdaki konu işletmeniz için de geçerliyse sorunuzu ya da ihtiyacınızı yazın; ne yapılması gerektiğini ve ne kadar süreceğini kalem kalem söyleyelim. Sonuç ya da sıralama garantisi vermeyiz; yaptığımız işi yazılı raporlarız.{service && <> Ayrıntıyı <a href={`/${service.slug}/`}>{service.name}</a> sayfasında bulabilirsiniz.</>}</p>
      <div class="post-cta-btns">
        <a class="btn btn-solid" href={WA_ANALYSIS} rel="noopener">{CTA_LABEL}<Icon name="arrow" size={20} /></a>
        <a class="btn btn-outline" href="/iletisim/">İletişim formu</a>
        <a class="btn btn-outline" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
      </div>
    </section>
  </article>

  <section class="rel-sec" aria-labelledby="devami">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h2" id="devami">Diğer <em>yazılar</em></h2>
      </div>
      <div class="rel-grid">
        {others.map((o) => (
          <a class="rel-card reveal" href={`/blog/${o.id}/`}><h3>{o.data.title}</h3><p>{o.data.description}</p><span class="go">Okuyun<Icon name="arrow" size={16} /></span></a>
        ))}
      </div>
    </div>
  </section>

  <Chat />
</Page>
