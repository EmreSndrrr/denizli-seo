---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Serp from '../../components/Serp.astro';
import ReportChart from '../../components/ReportChart.astro';
import Contact from '../../components/Contact.astro';
import WorkPics from '../../components/WorkPics.astro';
import { SITE } from '../../data/site';
import { serviceBySlug } from '../../data/services';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const others = (await getCollection('blog')).filter((p) => p.id !== post.id).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}/`;
const fmt = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const service = post.data.service ? serviceBySlug(post.data.service) : undefined;
const published = post.data.date.toISOString();
const modified = (post.data.updated ?? post.data.date).toISOString();

const jsonld = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#yazi`,
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: published,
    dateModified: modified,
    inLanguage: 'tr-TR',
    image: `${SITE.url}/og/denizli-seo.jpg`,
    author: { '@type': 'Organization', '@id': `${SITE.url}/#isletme`, name: SITE.name },
    publisher: { '@id': `${SITE.url}/#isletme` },
    wordCount: words,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<Base title={`${post.data.title} | Denizli SEO`} description={post.data.description} jsonld={jsonld} type="article" published={published} modified={modified}>
  <section class="phero phero--post" aria-labelledby="baslik">
    <div class="phero__text">
      <nav class="crumbs" aria-label="Sayfa yolu"><a href="/">Ana sayfa</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a></nav>
      <h1 id="baslik">{post.data.title}</h1>
      <p class="phero__lead" data-rise style="--i:1">{post.data.description}</p>
      <p class="small muted" data-rise style="--i:2"><time datetime={published}>{fmt.format(post.data.date)}</time> · {minutes} dakikalık okuma</p>
    </div>
    <div class="phero__visual">
      <div class="pfrag" data-reveal>
        {post.data.visual === 'serp' ? <Serp label="Örnek görünüm." /> : <div class="panel-ui"><p class="panel__head">Örnek rapor: altı ayda ortalama sıra</p><ReportChart /></div>}
      </div>
    </div>
  </section>

  <article class="sec post" aria-labelledby="baslik">
    <div class="prose">
      <Content />
    </div>
  </article>

  <section class="sec others" aria-labelledby="devami">
    <h2 id="devami" data-reveal>Devamını okuyun</h2>
    <ul>
      {others.map((o, i) => (
        <li data-reveal style={`--i:${i}`}><a href={`/blog/${o.id}/`}><span class="others__name">{o.data.title} <span aria-hidden="true">→</span></span><span class="others__text">{o.data.description}</span></a></li>
      ))}
      {service && (
        <li data-reveal style="--i:1"><a href={`/${service.slug}/`}><span class="others__name">İlgili hizmet: {service.name} <span aria-hidden="true">→</span></span><span class="others__text">{service.lead}</span></a></li>
      )}
    </ul>
  </section>

  <WorkPics title="Bu notları yazan ekibin işleri" />

  <Contact />
</Base>
