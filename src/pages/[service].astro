---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import MapStage from '../components/MapStage.astro';
import Serp from '../components/Serp.astro';
import Vitals from '../components/Vitals.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Work from '../components/Work.astro';
import Icon from '../components/Icon.astro';
import { SERVICES, type Service } from '../data/services';
import { PROJECTS } from '../data/projects';
import { SITE, DISTRICTS, waLink, CTA_LABEL } from '../data/site';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { service: service.slug }, props: { service } }));
}

interface Props { service: Service }
const { service } = Astro.props;
const url = `${SITE.url}/${service.slug}/`;
const others = SERVICES.filter((s) => s.slug !== service.slug);
const wa = waLink(`Merhaba, ücretsiz SEO analizi istiyorum. ${service.name} ile ilgileniyoruz. İşletmemin adı ve ilçesi: `);
const icons = { 'yerel-seo': 'pin', 'teknik-seo': 'gauge', 'icerik-seo': 'doc', 'web-tasarim': 'layout' } as const;
const shot = PROJECTS.find((p) => p.name === 'Balkan Endüstriyel Mutfak')!;
// Venti projects that include this kind of work
const workFor: Record<string, string[]> = {
  'yerel-seo': ['Denizli Kuyumcu', 'Yörükoğulları Nakliyat', 'Eseoğlu Sondaj', 'Jarkotech'],
  'teknik-seo': ['Jarkotech', 'Bilgi Dem Akademi', 'Denizli Kuyumcu', 'Balkan Endüstriyel Mutfak'],
  'icerik-seo': ['Elea Premium Stay', 'Fairystone Travel', 'World Trip Advisor', 'Travel Agency Türkiye'],
  'web-tasarim': ['Tekdağ Elektronik', 'Essence Travel', 'Yörükoğulları Nakliyat', 'Bilgi Dem Akademi'],
};

// what this service changes on the map, in the sample model the home page uses
const presets: Record<string, Record<string, unknown>> = {
  'yerel-seo': { profile: true },
  'teknik-seo': { speed: true },
  'icerik-seo': { content: 3 },
  'web-tasarim': { pages: true },
};

const jsonld = [
  {
    '@type': 'Service',
    '@id': `${url}#hizmet`,
    name: service.name,
    serviceType: service.name,
    description: service.lead,
    url,
    provider: { '@id': `${SITE.url}/#isletme` },
    areaServed: { '@type': 'AdministrativeArea', name: 'Denizli' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: service.name,
      itemListElement: service.items.map((item) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: item.name, description: item.text } })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: service.name, item: url },
    ],
  },
  { '@type': 'FAQPage', '@id': `${url}#sss`, mainEntity: service.faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---
<Base title={service.title} description={service.description} jsonld={jsonld}>
  <PageHead crumbs={[{ href: '/', label: 'Ana sayfa' }, { label: service.name }]} h1={service.h1} lead={service.lead}>
    <Fragment slot="acts">
      <a class="button" href={wa} rel="noopener">{CTA_LABEL}<Icon name="arrow" size={18} /></a>
      <a class="button button--outline" href={`tel:${SITE.phone}`}><Icon name="phone" size={18} />{SITE.phoneDisplay}</a>
    </Fragment>
    <div slot="after" class="phero__ctl ctl" data-rise style="--i:3">
      <button class="switch" type="button" role="switch" aria-checked="true" data-stage-toggle><span class="switch__knob" aria-hidden="true"></span>Haritada bu işin etkisi</button>
      <p class="small muted">Anahtarı kapatıp açın: örnek haritada, bu iş yapılmadan önceki ve sonraki sıra.</p>
    </div>
    <MapStage preset={presets[service.slug]} />
  </PageHead>

  <section class="sec band band--white" aria-labelledby="ne-yapiyoruz"><div class="wrap svc">
    <div class="svc__fixed">
      <h2 id="ne-yapiyoruz" data-reveal>{service.statementHead}</h2>
      <p class="lead" data-reveal style="--i:1">{service.statement}</p>
      <div class="svc__frag" data-reveal style="--i:2">
        {service.slug === 'teknik-seo' ? (
          <div class="panel-ui"><p class="panel__head">Google’ın sayfa deneyimi ölçüleri</p><Vitals /><p class="small muted">Örnek ölçüm. Çubuklar, değeri Google’ın “iyi” sınırına göre gösterir.</p></div>
        ) : service.slug === 'web-tasarim' ? (
          <a class="svc__shot" href={shot.url} rel="noopener" target="_blank">
            <Image src={shot.shot!} alt={`${shot.name} sitesinin ana sayfası`} widths={[500, 800, 1100]} sizes="(max-width: 1023px) 100vw, 40vw" loading="lazy" />
            <span class="slide__cap"><b>{shot.name}</b><span>{shot.work}</span></span>
          </a>
        ) : (
          <Serp queries={service.queries} label={service.slug === 'icerik-seo' ? 'Örnek görünüm. Müşterinin sorduğu sorular.' : 'Örnek görünüm. İşletme adları temsilî.'} />
        )}
      </div>
    </div>
    <div class="svc__items">
      <h2 class="sr-only">Bu işte ne yapıyoruz</h2>
      <ul>
        {service.items.map((item) => (
          <li data-reveal><span class="svc__tick"><Icon name="check" size={16} /></span><div><h3>{item.name}</h3><p>{item.text}</p></div></li>
        ))}
      </ul>
    </div>
  </div></section>

  {service.slug === 'yerel-seo' && (
    <section class="sec band" aria-labelledby="ilceler"><div class="wrap districts">
      <div class="districts__head">
        <h2 id="ilceler" data-reveal>{DISTRICTS.length} ilçe, {DISTRICTS.length} ayrı harita</h2>
        <p data-reveal style="--i:1">Arama, arayanın bulunduğu yere göre değişir. Merkezefendi’den yapılan aramayla Çivril’den yapılan arama aynı haritayı göstermez. Hizmet verdiğiniz her ilçe için ayrı bakarız.</p>
      </div>
      <ul class="districts__list" data-reveal style="--i:2">{DISTRICTS.map((d) => <li><Icon name="pin" size={14} />{d}</li>)}</ul>
    </div></section>
  )}

  <Work names={workFor[service.slug]} title="Bu işi yaptığımız siteler" intro="Venti Dijital Ajans’ın bu hizmeti verdiği sitelerden; hepsi yayında, üzerine tıklayıp açabilirsiniz." />

  <section class="sec band" aria-labelledby="adimlar"><div class="wrap steps">
    <h2 id="adimlar" data-reveal>Nasıl ilerleriz</h2>
    <ol>
      {service.steps.map((s, i) => (
        <li data-reveal style={`--i:${i}`}><span class="steps__dot" aria-hidden="true"></span><p class="steps__line">{s.line}</p><p>{s.text}</p></li>
      ))}
    </ol>
  </div></section>

  <Faq items={service.faq} title="Sorular" />

  <section class="sec band" aria-labelledby="diger"><div class="wrap others">
    <h2 id="diger" data-reveal>Diğer hizmetler</h2>
    <ul>
      {others.map((o, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a href={`/${o.slug}/`}><span class="chip-icon"><Icon name={icons[o.slug as keyof typeof icons]} size={22} /></span><span class="others__name">{o.name}</span><span class="others__text">{o.lead}</span><span class="others__go">İnceleyin <Icon name="arrow" size={16} /></span></a>
        </li>
      ))}
    </ul>
  </div></section>

  <Contact />
</Base>
