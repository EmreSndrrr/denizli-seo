---
// Services overview: the five services, who each one suits, how the result is measured.
import Page from '../layouts/Page.astro';
import Banner from '../components/home/Banner.astro';
import Cycle from '../components/home/Cycle.astro';
import Faq from '../components/home/Faq.astro';
import Chat from '../components/home/Chat.astro';
import Icon from '../components/Icon.astro';
import { SERVICES } from '../data/services';
import type { Qa } from '../data/services';
import { PROCESS } from '../data/home';
import { SITE, WA_ANALYSIS, CTA_LABEL } from '../data/site';

const title = 'Denizli SEO Hizmetleri: Yerel, Teknik, İçerik, Backlink';
const description =
  'Denizli’deki işletmeler için beş SEO hizmeti: yerel SEO ve Google Haritalar, teknik SEO, içerik SEO, backlink ve otorite, SEO uyumlu web tasarım.';
const url = `${SITE.url}/hizmetler/`;
const tones = ['pink', 'orange', 'purple', 'pink', 'orange'] as const;

const faq: Qa[] = [
  { q: 'Hangi hizmetle başlamalıyım?', a: 'Ücretsiz analizde sitenize ve Google’daki durumunuza bakar, hangi işin sizi en çok geride tuttuğunu söyleriz. Sitesi olmayan işletme için başlangıç web tasarımdır; sitesi sağlam ama haritada görünmeyen için yerel SEO; siteyi Google’ın hiç göstermediği durumda teknik SEO.' },
  { q: 'Birden fazla hizmeti birlikte almak zorunda mıyım?', a: 'Hayır. İhtiyacınız olan işi seçersiniz; yapılacak her kalem teklifte yazılı olur, sonradan kalem eklemek de mümkündür. Hizmetler birbirini besler ama birbirine bağlı değildir.' },
  { q: 'Sıralama garantisi veriyor musunuz?', a: 'Hayır. Sıralamayı Google belirler ve hiçbir ajans bunu garanti edemez. Verdiğimiz söz, yapılacak işlerin yazılı listesi ve her ay rakamlı rapordur.' },
  { q: 'Google reklamı ve sosyal medya hizmeti de var mı?', a: 'Denizli SEO, arama motoru optimizasyonuna odaklanır. Google reklamları, sosyal medya reklamları ve sosyal medya yönetimi, bağlı olduğumuz Venti Dijital Ajans’ın (ventiajans.com) hizmetleridir; aynı ekip yürütür.' },
  { q: 'Ücret neye göre belirleniyor?', a: 'Aranan kelimelerin rekabetine, sitenizin durumuna ve yapılacak iş miktarına göre. İlk görüşmede sitenize bakar, ne yapılacağını kalem kalem yazılı teklif ederiz.' },
];

const jsonld = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#sayfa`,
    url,
    name: 'Denizli SEO hizmetleri',
    description,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#isletme` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: SERVICES.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/${s.slug}/`,
        name: s.name,
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Hizmetler', item: url },
    ],
  },
  { '@type': 'FAQPage', '@id': `${url}#sss`, mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---
<Page title={title} description={description} jsonld={jsonld} image="/og/hizmetler.jpg" imageAlt="Denizli SEO hizmetleri: beş hizmet, tek ekip">
  <Banner crumbs={[{ href: '/', label: 'Ana sayfa' }, { label: 'Hizmetler' }]} h1={['Beş hizmet,', 'tek ekip.']} lead="Denizli’de sizi arayan müşterinin sizi bulması için gereken işler: harita, teknik altyapı, içerik, bağlantı ve site. Birini seçin ya da birlikte planlayalım.">
    <a class="btn btn-solid" href={WA_ANALYSIS} rel="noopener">{CTA_LABEL}<Icon name="arrow" size={20} /></a>
    <a class="btn btn-outline" href="/iletisim/">İletişim</a>
  </Banner>

  <section class="svc-list" aria-labelledby="hizmet-listesi">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h2" id="hizmet-listesi">Ne <em>yapıyoruz</em> ?</h2>
        <p class="lede">Her hizmetin kendi sayfası var: ne yaptığımız, nasıl ilerlediği, sık sorulan sorular ve sonucu nasıl göreceğiniz.</p>
      </div>
      <div class="svc-grid">
        {SERVICES.map((s, i) => (
          <a class="svc-card reveal" href={`/${s.slug}/`} style={`--tone:var(--${tones[i % tones.length]});--tone-text:var(--${tones[i % tones.length]}-text)`}>
            <span class="svc-card-icon" aria-hidden="true"><Icon name={s.icon} size={26} /></span>
            <h3>{s.name}</h3>
            <p>{s.lead}</p>
            <ul>{s.items.slice(0, 3).map((it) => <li><Icon name="check" size={14} />{it.name}</li>)}</ul>
            <span class="go">Sayfayı inceleyin<Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="fit-sec" aria-labelledby="hangisi">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2 class="h2" id="hangisi">Hangi hizmet <em>size uygun</em> ?</h2>
        <p class="lede">Başlangıç noktanız belli değilse durumunuza en yakın satırdan başlayın; gerekirse birkaç hizmeti birlikte kurarız.</p>
      </div>
      <div class="fit">
        {SERVICES.map((s, i) => (
          <div class="fit-row reveal" style={`--tone:var(--${tones[i % tones.length]});--tone-text:var(--${tones[i % tones.length]}-text)`}>
            <h3><a href={`/${s.slug}/`}>{s.short}</a></h3>
            <p><b>Kime uygun</b>{s.fit}</p>
            <p><b>Sonucu nasıl görürsünüz</b>{s.measure}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cycle steps={PROCESS.map((p) => ({ title: p.title, text: p.text, tag: p.when }))} title="Hizmetler <em>nasıl ilerler</em>" intro="Hangi hizmeti seçerseniz seçin iş aynı sırayla yürür; ne yapılacağı ve ne zaman yapılacağı baştan yazılıdır." id="surec" />

  <Faq items={faq} title="Sorular" />

  <Chat />
</Page>
