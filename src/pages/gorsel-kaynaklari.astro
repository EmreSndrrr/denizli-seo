---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { IMAGES, VIDEO_CREDIT, type Credit } from '../data/images';
import { PROJECTS } from '../data/projects';

const title = 'Görsel kaynakları ve lisansları | Denizli SEO';
const description = 'Denizli SEO sitesinde kullanılan fotoğrafların, gravürlerin ve videonun yazarları, lisansları ve kaynakları.';
const rows: { credit: Credit; img?: (typeof IMAGES)[keyof typeof IMAGES] }[] = [
  ...Object.values(IMAGES).map((img) => ({ credit: img.credit, img })),
  { credit: VIDEO_CREDIT },
];
---
<Base title={title} description={description} noindex>
  <section class="phero wrap" aria-labelledby="baslik">
    <nav class="crumbs" aria-label="Sayfa yolu"><a href="/">Ana sayfa</a><span aria-hidden="true">/</span><span aria-current="page">Görsel kaynakları</span></nav>
    <h1 class="display phero__title" id="baslik">Görsel kaynakları</h1>
    <div class="phero__foot">
      <p class="lead phero__lead">Sitedeki fotoğraflar, gravürler ve video Wikimedia Commons’tan alındı. Her biri yazarının belirttiği lisansla kullanılır; Pamukkale ve çevresini gösterir, işletmemize ait değildir.</p>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="liste">
    <h2 class="head" id="liste">Fotoğraflar, gravürler ve video</h2>
    <div class="credits">
      {rows.map(({ credit, img }, i) => (
        <article class="credit" data-reveal style={`--i:${i % 3}`}>
          <figure class="credit__pic">
            {img
              ? <Image src={img.src} alt={img.alt} widths={[240, 360]} sizes="(max-width: 768px) 33vw, 15vw" loading="lazy" />
              : <img src="/video/pamukkale-su-poster.jpg" alt="Pamukkale travertenlerinin üzerinden akan su, videodan bir kare" width="1280" height="720" loading="lazy" />}
          </figure>
          <div class="credit__body">
            <h3>{credit.title}</h3>
            <p>{credit.author} · {credit.licenseUrl ? <a class="link" href={credit.licenseUrl} rel="noopener">{credit.license}</a> : credit.license} · <a class="link" href={credit.source} rel="noopener">Wikimedia Commons</a></p>
          </div>
        </article>
      ))}
    </div>
    <p style="margin-top:3rem">Bazı görseller sitede kırpılarak ve küçültülerek, video ise kısaltılıp sessiz hale getirilerek ve rengi hafifçe düzenlenerek kullanıldı. CC BY-SA lisanslı eserlerin değiştirilmiş halleri de aynı lisansla paylaşılır.</p>
    <p style="margin-top:1rem">Ana sayfadaki proje görüntüleri, Venti Dijital Ajans’ın yürüttüğü {PROJECTS.length} sitenin yayındaki ana sayfalarının ekran görüntüleridir.</p>
  </section>
</Base>
