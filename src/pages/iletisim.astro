---
import Page from '../layouts/Page.astro';
import Banner from '../components/home/Banner.astro';
import Cta from '../components/home/Cta.astro';
import PlaceMap from '../components/home/PlaceMap.astro';
import Icon from '../components/Icon.astro';
import { SITE, ADDRESS_LINE, WA_ANALYSIS, CTA_LABEL } from '../data/site';

const title = 'İletişim: Telefon, WhatsApp ve Adres | Denizli SEO';
const description = `Denizli SEO ile iletişim: ${SITE.phoneDisplay}, WhatsApp ve ${ADDRESS_LINE}. Sitenize birlikte bakalım.`;
const url = `${SITE.url}/iletisim/`;

const jsonld = [
  { '@type': 'ContactPage', '@id': `${url}#sayfa`, url, name: 'Denizli SEO iletişim', inLanguage: 'tr-TR', isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': SITE.parent.id } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'İletişim', item: url },
    ],
  },
];
---
<Page title={title} description={description} jsonld={jsonld} image="/og/iletisim.jpg" imageAlt="Denizli SEO iletişim: sitenize birlikte bakalım">
  <Banner crumbs={[{ href: '/', label: 'Ana sayfa' }, { label: 'İletişim' }]} h1={['Sitenize', 'birlikte bakalım.']} lead={`WhatsApp’tan yazın ya da arayın. Telefonu ${SITE.person} açar. Ofisimiz Pamukkale’de, 7/24 açığız.`}>
    <a class="btn btn-solid" href={WA_ANALYSIS} rel="noopener">{CTA_LABEL}<Icon name="arrow" size={20} /></a>
    <a class="btn btn-outline" href={`tel:${SITE.phone}`}><Icon name="phone" size={18} />{SITE.phoneDisplay}</a>
  </Banner>

  <section class="contact-sec" aria-label="İletişim bilgileri">
    <div class="wrap">
      <div class="info-card reveal" style="--tone:var(--pink)"><div class="info-head"><span class="why-icon"><Icon name="phone" size={22} /></span><h2>Telefon</h2></div><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a><small>{SITE.person}</small></div>
      <div class="info-card reveal" style="--tone:var(--orange)"><div class="info-head"><span class="why-icon"><Icon name="chat" size={22} /></span><h2>WhatsApp</h2></div><a href={`https://wa.me/${SITE.whatsapp}`} rel="noopener">{SITE.phoneDisplay}</a><small>Mesajınız yazılı gelir</small></div>
      <div class="info-card reveal" style="--tone:var(--purple)"><div class="info-head"><span class="why-icon"><Icon name="pin" size={22} /></span><h2>Ofis</h2></div><a href={SITE.mapsUrl} rel="noopener" target="_blank">{ADDRESS_LINE}</a><small>{SITE.hours} · Google’da Venti Dijital Ajans</small></div>
    </div>
  </section>

  <Cta />

  <section class="place-sec" aria-label="Ofisin haritadaki yeri">
    <div class="wrap"><PlaceMap /></div>
  </section>
</Page>
