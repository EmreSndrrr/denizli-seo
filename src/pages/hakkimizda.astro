---
import Page from '../layouts/Page.astro';
import Banner from '../components/home/Banner.astro';
import About from '../components/home/About.astro';
import Why from '../components/home/Why.astro';
import Cycle from '../components/home/Cycle.astro';
import Rating from '../components/home/Rating.astro';
import Brands from '../components/home/Brands.astro';
import Chat from '../components/home/Chat.astro';
import Icon from '../components/Icon.astro';
import { PROCESS } from '../data/home';
import { SITE, WA_ANALYSIS, CTA_LABEL } from '../data/site';

const title = "Hakkımızda: Venti Dijital Ajans’ın SEO Ekibi | Denizli SEO";
const description =
  "Denizli SEO, Pamukkale’deki Venti Dijital Ajans’ın SEO markasıdır. Site, arama ve reklamı tek ekipte yürütür, her ay rakamla rapor veririz.";
const url = `${SITE.url}/hakkimizda/`;

const jsonld = [
  { '@type': 'AboutPage', '@id': `${url}#sayfa`, url, name: 'Denizli SEO hakkında', about: { '@id': `${SITE.url}/#isletme` } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Hakkımızda', item: url },
    ],
  },
];
---
<Page title={title} description={description} jsonld={jsonld}>
  <Banner crumbs={[{ href: '/', label: 'Ana sayfa' }, { label: 'Hakkımızda' }]} h1={['Venti’nin', 'SEO ekibiyiz.']} lead="Denizli SEO, Pamukkale’deki Venti Dijital Ajans’ın arama motoru optimizasyonu markasıdır. Venti; web sitesini, Google’daki sırayı ve reklamı tek ekipte yürütür.">
    <a class="btn btn-solid" href={WA_ANALYSIS} rel="noopener">{CTA_LABEL}<Icon name="arrow" size={20} /></a>
    <a class="btn btn-outline" href="/iletisim/">İletişim</a>
  </Banner>
  <About />
  <Why />
  <Cycle steps={PROCESS.map((p) => ({ title: p.title, text: p.text, tag: p.when }))} title="Adım adım <em>proje süreci</em>" intro="Her iş aynı sırayla ilerler; ne yapılacağı ve ne zaman yapılacağı yazılı olarak baştan söylenir." id="surec" />
  <Rating />
  <Brands />
  <Chat />
</Page>
