---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Contact from '../components/Contact.astro';
import WorkPics from '../components/WorkPics.astro';
import { PROJECTS } from '../data/projects';
import { SITE, ADDRESS_LINE } from '../data/site';

const title = "Hakkımızda: Venti Dijital Ajans’ın SEO Ekibi | Denizli SEO";
const description =
  "Denizli SEO, Pamukkale’deki Venti Dijital Ajans’ın SEO markasıdır. Site, arama ve reklamı tek ekipte yürütür, her ay rakamla rapor veririz.";
const url = `${SITE.url}/hakkimizda/`;
const shot = PROJECTS.find((p) => p.name === 'Denizli Kuyumcu')!;

const jsonld = [
  { '@type': 'AboutPage', '@id': `${url}#sayfa`, url, name: 'Denizli SEO hakkında', about: { '@id': `${SITE.url}/#isletme` } },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Hakkımızda', item: url },
    ],
  },
];
---
<Base title={title} description={description} jsonld={jsonld}>
  <PageHead crumbs={[{ href: '/', label: 'Ana sayfa' }, { label: 'Hakkımızda' }]} h1={['Venti’nin', 'SEO ekibiyiz.']} lead="Denizli SEO, Pamukkale’deki Venti Dijital Ajans’ın arama motoru optimizasyonu markasıdır. Venti; web sitesini, Google’daki sırayı ve reklamı tek ekipte yürütür.">
    <Fragment slot="acts">
      <a class="button" href="/iletisim/">İletişime geçin</a>
      <a class="textlink" href="/#isler">Yaptığımız siteler <span aria-hidden="true">→</span></a>
    </Fragment>
    <a class="pshot" href={shot.url} rel="noopener" target="_blank">
      <Image src={shot.shot!} alt={`${shot.name} sitesinin ana sayfası`} widths={[600, 900, 1300]} sizes="(max-width: 1023px) 100vw, 50vw" loading="eager" />
      <span class="slide__cap"><b>{shot.name}</b><span>{shot.work}</span></span>
    </a>
  </PageHead>

  <section class="sec principles" aria-labelledby="ilkeler">
    <div class="principles__head">
      <h2 id="ilkeler" data-reveal>Dört ilke</h2>
      <p data-reveal style="--i:1">İşe başlamadan önce bu ilkeleri açıkça söyleriz; iş boyunca da bunlara uyarız.</p>
    </div>
    <ul class="principles__list">
      <li data-reveal><h3>Tek elden</h3><p>Site, SEO ve reklam aynı ekipte. Bir kanalın verisi diğerini besler; işiniz ajanslar arasında bölünmez.</p></li>
      <li data-reveal style="--i:1"><h3>Rakamla rapor</h3><p>Her ay sıra, ziyaret ve gelen talep rakamla raporlanır. Sonuç vermeyen çalışma da raporda yazar.</p></li>
      <li data-reveal style="--i:2"><h3>Doğrudan iletişim</h3><p>İşi yapan kişiyle konuşursunuz. Araya hesap yöneticisi girmez.</p></li>
      <li data-reveal style="--i:3"><h3>Garanti değil, şeffaflık</h3><p>Google’da sıra garanti edilemez. Yapılacak işi, süresini ve sonucunu açıkça yazarız.</p></li>
    </ul>
  </section>

  <section class="sec why" aria-labelledby="neden">
    <h2 id="neden" data-reveal>Neden ayrı bir marka?</h2>
    <p class="lead" data-reveal style="--i:1">Denizli SEO, Venti’nin SEO hizmetlerini tek bir adreste anlatır. Google reklamları ve sosyal medya için <a href={SITE.parent.url} rel="noopener">ventiajans.com</a>. Muhatabınız {SITE.person}; ofis {ADDRESS_LINE}.</p>
  </section>

  <WorkPics names={['Bilgi Dem Akademi', 'Yörükoğulları Nakliyat', 'Balkan Endüstriyel Mutfak', 'Elea Premium Stay']} />

  <Contact />
</Base>
