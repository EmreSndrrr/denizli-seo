---
import Home from '../layouts/Home.astro';
import Nav from '../components/home/Nav.astro';
import Hero from '../components/home/Hero.astro';
import Lens from '../components/home/Lens.astro';
import Services from '../components/home/Services.astro';
import Why from '../components/home/Why.astro';
import Process from '../components/home/Process.astro';
import DenizliMap from '../components/home/DenizliMap.astro';
import Projects from '../components/home/Projects.astro';
import Chat from '../components/home/Chat.astro';
import About from '../components/home/About.astro';
import Rating from '../components/home/Rating.astro';
import Brands from '../components/home/Brands.astro';
import Faq from '../components/home/Faq.astro';
import Cta from '../components/home/Cta.astro';
import Footer from '../components/home/Footer.astro';
import { HOME_FAQ } from '../data/faq';
import { SITE } from '../data/site';

const title = "Denizli SEO | Google’da ve Haritalar’da Üst Sıra";
const description =
  "Yerel SEO, Google Haritalar, teknik SEO ve içerikle Denizli’de sizi arayan müşterinin karşısına çıkmanızı sağlarız. Venti Dijital Ajans’ın SEO ekibi.";

const jsonld = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#sayfa`,
    url: `${SITE.url}/`,
    name: title,
    description,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#isletme` },
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#sss`,
    mainEntity: HOME_FAQ.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
  },
];
---
<Home title={title} description={description} jsonld={jsonld}>
  <Nav home />
  <main id="icerik" lang="tr">
    <Hero />
    <Lens />
    <Services />
    <Why />
    <Process />
    <Projects />
    <Chat />
    <About />
    <Rating />
    <Brands />
    <DenizliMap />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Home>
