---
import Base from '../layouts/Base.astro';
import MapStory from '../components/MapStory.astro';
import Exchange from '../components/Exchange.astro';
import WorkStrip from '../components/WorkStrip.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { HOME_FAQ } from '../data/faq';
import { SITE } from '../data/site';

const title = "Denizli SEO | Google’da ve Haritalar’da Üst Sıra";
const description =
  "Yerel SEO, Google Haritalar, teknik SEO ve içerikle Denizli’de sizi arayan müşterinin karşısına çıkmanızı sağlarız. Venti Dijital Ajans’ın SEO ekibi.";

const jsonld = [
  { '@type': 'WebSite', '@id': `${SITE.url}/#site`, url: `${SITE.url}/`, name: SITE.name, inLanguage: 'tr-TR', publisher: { '@id': `${SITE.url}/#isletme` } },
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#sss`,
    mainEntity: HOME_FAQ.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
  },
];
---
<Base title={title} description={description} jsonld={jsonld}>
  <MapStory />
  <Exchange />
  <WorkStrip />
  <Faq items={HOME_FAQ} />
  <Contact />
</Base>
