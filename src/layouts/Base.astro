---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;            // absolute path under /public, e.g. /og/denizli-seo.jpg
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
  overlayHeader?: boolean;
  noindex?: boolean;
  published?: string;
  modified?: string;
}

const {
  title,
  description,
  image = '/og/denizli-seo.jpg',
  imageAlt = 'Denizli SEO: Pamukkale travertenleri üzerinde Denizli SEO yazısı',
  type = 'website',
  jsonld = [],
  overlayHeader = false,
  noindex = false,
  published,
  modified,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

// The business, described once and referenced by @id from every page.
const business = {
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#isletme`,
  name: SITE.name,
  url: `${SITE.url}/`,
  description:
    "Denizli SEO, Venti Dijital Ajans’ın arama motoru optimizasyonu markasıdır: yerel SEO, Google Haritalar, teknik SEO, içerik SEO ve SEO uyumlu web tasarım.",
  image: `${SITE.url}/og/denizli-seo.jpg`,
  logo: `${SITE.url}/favicon-512.png`,
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    postalCode: SITE.address.postalCode,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Denizli' },
  parentOrganization: { '@type': 'Organization', '@id': SITE.parent.id, name: SITE.parent.name, url: SITE.parent.url },
  knowsAbout: ['Arama motoru optimizasyonu', 'Yerel SEO', 'Google İşletme Profili', 'Teknik SEO', 'İçerik pazarlaması', 'Web tasarım'],
};
const graph = { '@context': 'https://schema.org', '@graph': [business, ...jsonld] };
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/gambarino-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <Header overlay={overlayHeader} />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
