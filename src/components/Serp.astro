---
// A Google-style result page, drawn in HTML: the query types itself, the map pack shows three sample
// businesses and the place the visitor's own business is aiming for. Sample content, labelled as such.
interface Props { queries?: string[]; label?: string }
const {
  queries = ['denizli kuyumcu', 'merkezefendi diş hekimi', 'pamukkale oto servis', 'yakınımdaki emlakçı'],
  label = 'Örnek görünüm. İşletme adları temsilî.',
} = Astro.props;
const items = [
  { n: 1, name: 'İşletme A', meta: '4,8 puan (126 yorum) · Merkezefendi', state: 'Açık' },
  { n: 2, name: 'İşletme B', meta: '4,6 puan (88 yorum) · Pamukkale', state: 'Açık' },
  { n: 3, name: 'İşletme C', meta: '4,9 puan (41 yorum) · Merkezefendi', state: '19.00’da kapanır' },
];
---
<div class="ui serp" data-ui data-serp={queries.join('|')}>
  <div class="serp__bar" role="img" aria-label={`Google arama kutusu: ${queries[0]}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14Z"/></svg>
    <span class="serp__q" data-serp-q>{queries[0]}</span>
  </div>
  <div class="serp__tabs" aria-hidden="true"><b>Tümü</b><span>Haritalar</span><span>Görseller</span><span>Haberler</span></div>
  <div class="serp__map" aria-hidden="true">
    <svg viewBox="0 0 600 220" preserveAspectRatio="xMidYMid slice">
      <rect width="600" height="220" fill="#e8eaed" />
      <path d="M0 150 C120 130 220 170 330 140 S520 90 600 110 L600 220 L0 220 Z" fill="#c9e7d0" />
      <path d="M430 0 h170 v70 c-60 10 -120 -5 -170 -30 Z" fill="#b6d7f2" />
      <g stroke="#ffffff" stroke-linecap="round" fill="none">
        <path d="M-10 60 L610 95" stroke-width="10" />
        <path d="M150 -10 L210 230" stroke-width="8" />
        <path d="M380 -10 L330 230" stroke-width="8" />
        <path d="M-10 175 L610 150" stroke-width="5" />
        <path d="M60 -10 L90 230" stroke-width="4" />
        <path d="M500 -10 L520 230" stroke-width="4" />
      </g>
      <g font-family="Arial, sans-serif" font-size="13" font-weight="700" text-anchor="middle">
        <g transform="translate(250 82)"><path d="M0 0 c-12 -14 -18 -22 -18 -32 a18 18 0 0 1 36 0 c0 10 -6 18 -18 32 Z" fill="#ea4335" /><text y="-27" fill="#fff">1</text></g>
        <g transform="translate(345 128)"><path d="M0 0 c-12 -14 -18 -22 -18 -32 a18 18 0 0 1 36 0 c0 10 -6 18 -18 32 Z" fill="#ea4335" /><text y="-27" fill="#fff">2</text></g>
        <g transform="translate(176 150)"><path d="M0 0 c-12 -14 -18 -22 -18 -32 a18 18 0 0 1 36 0 c0 10 -6 18 -18 32 Z" fill="#ea4335" /><text y="-27" fill="#fff">3</text></g>
        <g transform="translate(455 172)"><path d="M0 0 c-12 -14 -18 -22 -18 -32 a18 18 0 0 1 36 0 c0 10 -6 18 -18 32 Z" fill="#0f0f0f" /><text y="-27" fill="#dafa9c">?</text></g>
      </g>
    </svg>
  </div>
  <ol class="serp__list">
    {items.map((it) => (
      <li class="serp__item"><i>{it.n}</i><span>{it.name}<small>{it.meta}</small></span><em>{it.state}</em></li>
    ))}
    <li class="serp__item serp__item--you"><i>?</i><span>Sizin işletmeniz<small>Haritada ilk üçe girmek için çalışırız</small></span><em></em></li>
  </ol>
  <p class="serp__note">{label}</p>
</div>
