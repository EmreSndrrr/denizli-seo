---
// How it works as three exchanges: what the client writes, and what comes back.
import Serp from './Serp.astro';
import ReportChart from './ReportChart.astro';
interface Props { id?: string; title?: string }
const { id = 'nasil', title = 'Nasıl çalışırız' } = Astro.props;
const plan = [
  ['İşletme Profili düzeni', '1. hafta'],
  ['Site hızı ve teknik düzeltmeler', '1–3. hafta'],
  ['İlçe sayfaları', '2–4. hafta'],
  ['Yorum düzeni', '2. haftadan itibaren'],
  ['Soru sayfaları', 'her ay'],
];
---
<section class="sec band" id={id} aria-labelledby={`${id}-baslik`}>
  <div class="wrap">
    <div class="shead">
      <h2 id={`${id}-baslik`} data-reveal>{title}</h2>
      <p data-reveal style="--i:1">Üç adım: siz yazarsınız, biz aramanızı ölçer, yazılı plan çıkarır ve her ay raporlarız.</p>
    </div>
    <ol class="xch">
      <li class="xch__item" data-reveal>
        <h3 class="xch__say">Önce, bize yazarsınız.</h3>
        <p class="xch__call"><span class="sr-only">Siz: </span>Merkezefendi’de kuyumcuyuz. Haritada neden çıkmıyoruz?</p>
        <div class="xch__resp"><Serp queries={['denizli kuyumcu']} /></div>
      </li>
      <li class="xch__item" data-reveal style="--i:1">
        <h3 class="xch__say">Sonra, yazılı plan gelir.</h3>
        <p class="xch__call"><span class="sr-only">Siz: </span>Ne yapılacak, ne kadar sürer?</p>
        <div class="xch__resp">
          <div class="ui plan" data-ui>
            <p class="plan__head">Örnek plan</p>
            <ul>{plan.map((p) => <li><span>{p[0]}</span><span>{p[1]}</span></li>)}</ul>
            <p class="plan__foot">Teklifte olmayan iş sonradan eklenmez.</p>
          </div>
        </div>
      </li>
      <li class="xch__item" data-reveal style="--i:2">
        <h3 class="xch__say">Her ay sonunda, rapor.</h3>
        <p class="xch__call"><span class="sr-only">Siz: </span>Bu ay ne değişti?</p>
        <div class="xch__resp">
          <div class="report" data-ui>
            <div class="report__text">
              <p class="report__head">Örnek rapor: “denizli kuyumcu”</p>
              <p>Ortalama sıra altı ayda 18’den 4’e. Rapor; sırayı, siteye gelen ziyareti ve profilden gelen aramayı birlikte gösterir. Sonuç vermeyen çalışma da raporda yazar.</p>
            </div>
            <ReportChart />
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>
