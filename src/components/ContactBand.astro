---
import { Image } from 'astro:assets';
import { SITE, WA_GENERAL } from '../data/site';
import { IMAGES } from '../data/images';

interface Props { sentence?: string; question?: string }
const {
  sentence = "Müşteriniz sizi Google’da bulamıyorsa, sitenize birlikte bakalım.",
  question = 'Nereden başlayalım?',
} = Astro.props;
const pic = IMAGES.laodikya;
---
<section class="contact wrap" aria-labelledby="iletisim-baslik">
  <div class="grid">
    <p class="contact__sentence" data-reveal>{sentence}</p>
    <figure class="contact__pic" data-reveal="open" style="--i:1">
      <Image src={pic.src} alt={pic.alt} width={336} height={336} widths={[192, 336]} sizes="168px" loading="lazy" />
    </figure>
    <div class="contact__links" data-reveal style="--i:2">
      <h2 class="contact__q" id="iletisim-baslik">{question}</h2>
      <a class="link" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
      <a class="link" href={WA_GENERAL} data-wa-query rel="noopener">WhatsApp’tan yazın</a>
      <p class="contact__meta">Pamukkale, Denizli. Telefonu {SITE.person} açar.</p>
    </div>
  </div>
</section>
