---
// The work as one strip that slides sideways while the page scrolls down (desktop), or under the thumb
// (phone). Each slide is a live site's home page; the slides turn in 3D as they pass the middle.
import { Image } from 'astro:assets';
import { PROJECTS } from '../data/projects';
const pick = ['Denizli Kuyumcu', 'Yörükoğulları Nakliyat', 'Balkan Endüstriyel Mutfak', 'Elea Premium Stay', 'Bilgi Dem Akademi', 'Eseoğlu Sondaj', 'Jarkotech', 'Tekdağ Elektronik'];
const shown = pick.map((n) => PROJECTS.find((p) => p.name === n)!).filter((p) => p.shot);
---
<section class="scene work" id="isler" data-scene="strip" aria-labelledby="isler-baslik">
  <div class="scene-stage work__stage">
    <div class="work__head">
      <h2 id="isler-baslik" data-reveal>Yaptığımız siteler</h2>
      <p data-reveal style="--i:1">
        Venti Dijital Ajans’ın kurduğu ya da SEO’sunu yürüttüğü sitelerden bazıları; hepsi yayında.
        Ajansın Google puanı <a href="https://share.google/YVUE42SqN5ipf0y1j" rel="noopener" target="_blank">5,0 (28 yorum, Ekim 2026)</a>.
      </p>
    </div>
    <div class="work__view" data-strip-view>
      <ul class="work__track" data-strip-track>
        {shown.map((p, i) => (
          <li class="slide" data-slide>
            <a href={p.url} rel="noopener" target="_blank">
              <span class="slide__pic">
                <Image src={p.shot!} alt={`${p.name} sitesinin ana sayfası`} widths={[480, 800, 1100]} sizes="(max-width: 767px) 80vw, 46vw" loading={i < 3 ? 'eager' : 'lazy'} />
              </span>
              <span class="slide__cap"><b>{p.name}</b><span>{p.work}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a class="textlink work__all" href="https://www.ventiajans.com/projeler/" rel="noopener">Bütün projeler: ventiajans.com <span aria-hidden="true">→</span></a>
  </div>
</section>
