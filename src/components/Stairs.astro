---
import type { Step } from '../data/services';
interface Props { steps: Step[]; title?: string; id?: string }
const { steps, title = 'Nasıl çalışırız', id = 'nasil' } = Astro.props;
const starts = [1, 3, 5, 7];
---
<section class="section wrap" id={id} aria-labelledby={`${id}-baslik`}>
  <h2 class="sr-only" id={`${id}-baslik`}>{title}</h2>
  <ol class="stairs">
    {steps.map((step, i) => (
      <li class="stair" style={`--from:${starts[i] ?? 1};--k:${i}`}>
        <div class="stair__in" data-reveal="step" style={`--i:${i}`}>
          <h3 class="stair__line">{step.line}</h3>
          <p class="stair__text">{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
