---
// Four live sites from Venti's work at uneven widths, each linking to the site itself.
import { Image } from 'astro:assets';
import { PROJECTS } from '../data/projects';
interface Props { names?: string[]; title?: string; intro?: string; id?: string }
const {
  names = ['Denizli Kuyumcu', 'Yörükoğulları Nakliyat', 'Balkan Endüstriyel Mutfak', 'Elea Premium Stay'],
  title = 'Yaptığımız siteler',
  intro = 'Venti Dijital Ajans’ın yürüttüğü projelerden; hepsi yayında, üzerine tıklayıp açabilirsiniz.',
  id = 'isler',
} = Astro.props;
const work = names.map((n) => PROJECTS.find((p) => p.name === n)).filter((p) => p?.shot);
---
<section class="sec pics" aria-labelledby={`${id}-baslik`}>
  <div class="pics__head">
    <h2 id={`${id}-baslik`} data-reveal>{title}</h2>
    <p data-reveal style="--i:1">{intro}</p>
  </div>
  <ul class="pics__grid">
    {work.map((p, i) => (
      <li data-reveal style={`--i:${i}`}>
        <a href={p!.url} rel="noopener" target="_blank">
          <span class="pics__pic"><Image src={p!.shot!} alt={`${p!.name} sitesinin ana sayfası`} widths={[500, 800, 1100]} sizes="(max-width: 767px) 100vw, 50vw" loading="lazy" /></span>
          <span class="slide__cap"><b>{p!.name}</b><span>{p!.work}</span></span>
        </a>
      </li>
    ))}
  </ul>
</section>
