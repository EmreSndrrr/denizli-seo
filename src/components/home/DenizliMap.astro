---
// Türkiye, then Denizli, then its 19 districts on the real relief. With motion the page zooms from one into the next
// as it scrolls (denizli.ts); without motion the flat map and the relief sit side by side. Real borders, no sample ranks.
import turkey from '../../data/turkey-map.json';
---
<section class="dmap" id="denizli" aria-labelledby="denizli-baslik">
  <h2 class="sr-only" id="denizli-baslik">Türkiye’den Denizli’nin 19 ilçesine harita</h2>
  <div class="dmap-pin">
    <div class="wrap">
      <div class="dmap-view" data-dmap>
        <div class="tr-map" data-tr>
          <svg viewBox={`0 0 ${turkey.width} ${turkey.height}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="Türkiye haritası; Denizli ili işaretli">
            <g class="tr-others">{turkey.provinces.map((d) => <path d={d} />)}</g>
            <path class="tr-denizli" id="tr-denizli" d={turkey.denizli} />
            <circle class="tr-ring" cx={turkey.center[0]} cy={turkey.center[1]} r="11" />
          </svg>
        </div>
        <div class="dmap-3d" data-3d>
          <img class="dmap-poster" src="/map/denizli-3d.webp" width="1158" height="924" alt="Denizli’nin 19 ilçesi ve dağları, üç boyutlu harita" loading="lazy">
          <canvas class="dmap-canvas" aria-hidden="true" data-map-canvas></canvas>
          <div class="dmap-labels" aria-hidden="true" data-map-labels></div>
        </div>
        <p class="dmap-cap" data-cap aria-hidden="true"><b>Türkiye</b><span>81 il</span></p>
      </div>
      <p class="dmap-note">Harita © OpenStreetMap katkıda bulunanlar (geoBoundaries) · Yükseklik: AWS Terrain Tiles</p>
    </div>
  </div>
</section>
