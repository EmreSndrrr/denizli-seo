---
// Denizli's 19 districts as a real 3D relief. Each column is the sample rank of a business in that
// district; the switches raise them. Sample model, labelled as a sample on the page.
import Icon from '../Icon.astro';
import { DISTRICTS, CTA_LABEL } from '../../data/site';
const trade = 'kuyumcu';
const toggles = [
  { key: 'profile', label: 'İşletme Profili düzenli' },
  { key: 'speed', label: 'Site hızlı açılıyor' },
  { key: 'content', label: 'Soru sayfaları yazıldı' },
  { key: 'pages', label: 'İlçe sayfaları yayında' },
];
---
<section class="dmap" id="denizli" aria-labelledby="denizli-baslik">
  <div class="wrap dmap-in">
    <div class="dmap-copy reveal">
      <h2 class="h2" id="denizli-baslik">Denizli’nin <em>19</em> ilçesi, 19 ayrı arama.</h2>
      <p class="lede">Merkezefendi’den yapılan aramayla Çivril’den yapılan aynı sonucu göstermez. Haritadaki her sütun bir ilçe; sütun yükseldikçe o ilçede daha üst sıradasınız.</p>
      <form class="dmap-ctl" data-dmap-form onsubmit="return false" aria-label="Harita denemesi">
        <div class="dmap-pair">
          <label for="dmap-trade"><span>İşiniz</span><input id="dmap-trade" name="trade" value={trade} autocomplete="off" maxlength="40"></label>
          <label for="dmap-district"><span>İlçeniz</span>
            <select id="dmap-district" name="district">{DISTRICTS.map((d) => <option selected={d === 'Merkezefendi'}>{d}</option>)}</select>
          </label>
        </div>
        <div class="dmap-toggles" role="group" aria-label="Yapılan işler">
          {toggles.map((t) => <button type="button" class="toggle" role="switch" aria-checked="false" data-key={t.key}><span class="toggle-box" aria-hidden="true"><Icon name="check" size={14} /></span>{t.label}</button>)}
        </div>
      </form>
      <a class="btn btn-solid" href="#analiz">{CTA_LABEL}<Icon name="arrow" size={20} /></a>
    </div>

    <div class="dmap-card reveal" data-dmap>
      <div class="dmap-readout">
        <div class="dmap-q"><Icon name="search" size={18} /><span data-out-query>denizli {trade}</span></div>
        <dl class="dmap-nums" aria-live="polite">
          <div><dt>İlk üçte olduğunuz ilçe</dt><dd><span data-out-top3>0</span><small> / 19</small></dd></div>
          <div><dt>Ortalama sıranız</dt><dd data-out-avg>14,0</dd></div>
        </dl>
      </div>
      <div class="dmap-view">
        <img class="dmap-poster" src="/map/denizli-3d.webp" width="972" height="1080" alt="Denizli’nin 19 ilçesi ve dağları, üç boyutlu harita" loading="lazy">
        <canvas class="dmap-canvas" aria-hidden="true" data-map-canvas></canvas>
        <div class="dmap-labels" aria-hidden="true" data-map-labels></div>
      </div>
      <p class="dmap-note"><span><i data-tier="top"></i>İlk 3</span><span><i data-tier="mid"></i>4–10</span><span><i data-tier="low"></i>11 ve sonrası</span><em>Örnek gösterim. Harita © OpenStreetMap katkıda bulunanlar · Yükseklik: AWS Terrain Tiles</em></p>
    </div>
  </div>
</section>
