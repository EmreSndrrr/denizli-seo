---
// Core Web Vitals readout. Sample measurement, labelled; bars show the value against Google's "good" limit.
const rows = [
  { k: 'LCP', name: 'En büyük içerik', value: '1,9 sn', w: 76, limit: '≤ 2,5 sn' },
  { k: 'INP', name: 'Etkileşim', value: '140 ms', w: 70, limit: '≤ 200 ms' },
  { k: 'CLS', name: 'Kayma', value: '0,04', w: 40, limit: '≤ 0,1' },
];
---
<div class="vit">
  <p class="vit-head">Google’ın sayfa deneyimi ölçüleri</p>
  {rows.map((r) => (
    <div class="vit-row" title={`${r.name}: ${r.value} (Google’ın “iyi” sınırı ${r.limit})`}>
      <b>{r.k}</b>
      <span class="vit-bar" aria-hidden="true"><i style={`width:${r.w}%`}></i></span>
      <output>{r.value}</output>
    </div>
  ))}
  <p class="vit-note">Örnek ölçüm. Çubuklar, değeri Google’ın “iyi” sınırına göre gösterir.</p>
</div>
