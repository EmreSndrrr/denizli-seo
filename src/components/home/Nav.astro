---
import Icon from '../Icon.astro';
import { SITE, CTA_LABEL } from '../../data/site';
import { SERVICES } from '../../data/services';
interface Props { home?: boolean }
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const pre = home ? '' : '/';
const onService = path.startsWith('/hizmetler') || SERVICES.some((s) => path.startsWith(`/${s.slug}/`));
const links = [
  { href: '/hizmetler/', label: 'Hizmetler', section: 'hizmetler', current: onService },
  { href: '/hakkimizda/', label: 'Hakkımızda', current: path.startsWith('/hakkimizda') },
  { href: `${pre}#isler`, label: 'İşler', section: 'isler' },
  { href: '/blog/', label: 'Blog', current: path.startsWith('/blog') },
  { href: '/iletisim/', label: 'İletişim', current: path.startsWith('/iletisim') },
];
---
<header class="nav" id="main-nav">
  <div class="wrap nav-in">
    <a class="logo" href={home ? '#top' : '/'} aria-label={`${SITE.name} ana sayfa`}>
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><circle cx="13" cy="13" r="9" fill="none" stroke="currentColor" stroke-width="3.4"></circle><path d="M20 20 L28.5 28.5" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path></svg>
      <span class="logo-word">Denizli SEO</span>
    </a>
    <nav class="nav-links" aria-label="Ana menü">
      {links.map((l) => <a href={l.href} data-section={l.section} class:list={[{ active: l.current }]} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="btn btn-outline btn-sm" href={`${pre}#analiz`}>{CTA_LABEL}</a>
      <button class="nav-toggle" id="mobile-menu-btn" type="button" aria-label="Menüyü aç veya kapat" aria-expanded="false" aria-controls="mobile-drawer"><Icon name="menu" size={20} /></button>
    </div>
  </div>
</header>
<nav class="mobile-drawer" id="mobile-drawer" aria-label="Mobil menü">
  {links.map((l) => <a href={l.href}><span>{l.label}</span><Icon name="arrow" size={18} /></a>)}
  <a class="btn btn-solid" href={`${pre}#analiz`}>{CTA_LABEL}</a>
</nav>
