---
import { SITE, DISTRICTS } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;            // absolute path under /public, e.g. /og/denizli-seo.jpg
  imageAlt?: string;
  type?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
  noindex?: boolean;
  published?: string;
  modified?: string;
  themeColor?: string;
  preload?: string[];        // font files to preload
}

const {
  title,
  description,
  image = '/og/denizli-seo.jpg',
  imageAlt = 'Denizli SEO: Denizli’de Google ve Haritalar’da üst sıra',
  type = 'website',
  jsonld = [],
  noindex = false,
  published,
  modified,
  themeColor = '#0b0e13',
  preload = ['/fonts/archivo-latin.woff2'],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

// Entities described once and referenced by @id from every page.
const business = {
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#isletme`,
  name: SITE.name,
  url: `${SITE.url}/`,
  description:
    'Denizli SEO, Venti Dijital Ajans’ın arama motoru optimizasyonu markasıdır: yerel SEO, Google Haritalar, teknik SEO, içerik SEO, backlink ve SEO uyumlu web tasarım.',
  image: `${SITE.url}/og/denizli-seo.jpg`,
  logo: `${SITE.url}/favicon-512.png`,
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    postalCode: SITE.address.postalCode,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.latitude, longitude: SITE.geo.longitude },
  hasMap: SITE.parent.sameAs[0],
  areaServed: [
    { '@type': 'City', name: 'Denizli' },
    ...DISTRICTS.map((d) => ({ '@type': 'AdministrativeArea', name: `${d}, Denizli` })),
  ],
  availableLanguage: 'tr',
  founder: { '@id': SITE.personId },
  parentOrganization: { '@id': SITE.parent.id },
  knowsAbout: ['Arama motoru optimizasyonu', 'Yerel SEO', 'Google İşletme Profili', 'Teknik SEO', 'İçerik SEO', 'Backlink', 'Web tasarım'],
};
const parent = {
  '@type': 'Organization',
  '@id': SITE.parent.id,
  name: SITE.parent.name,
  url: SITE.parent.url,
  logo: SITE.parent.logo,
  sameAs: SITE.parent.sameAs,
};
const person = {
  '@type': 'Person',
  '@id': SITE.personId,
  name: SITE.person,
  jobTitle: 'Kurucu',
  description: 'Yönetim Bilişim Sistemleri mezunu. 2018’den beri web tasarım, SEO ve Google Ads alanında çalışıyor.',
  url: SITE.founderUrl,
  worksFor: { '@id': SITE.parent.id },
  knowsAbout: ['Web tasarım', 'SEO', 'Google Ads', 'Yerel SEO'],
};
const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.name,
  inLanguage: 'tr-TR',
  publisher: { '@id': `${SITE.url}/#isletme` },
};
const graph = { '@context': 'https://schema.org', '@graph': [business, parent, person, website, ...jsonld] };
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="theme-color" content={themeColor} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Denizli SEO blog" href="/rss.xml" />
{preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<script is:inline>document.documentElement.classList.add('js')</script>
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
<slot name="head" />
