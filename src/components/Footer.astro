---
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';
const year = new Date().getFullYear();
const short: Record<string, string> = { 'yerel-seo': 'Yerel SEO', 'teknik-seo': 'Teknik SEO', 'icerik-seo': 'İçerik', 'web-tasarim': 'Web tasarım' };
---
<footer class="foot">
  <p class="foot__what">Denizli SEO, <a href={SITE.parent.url} rel="noopener">Venti Dijital Ajans</a>’ın markası.</p>
  <nav class="foot__links" aria-label="Alt menü">
    {SERVICES.map((s) => <a href={`/${s.slug}/`}>{short[s.slug] ?? s.name}</a>)}
    <a href="/hakkimizda/">Hakkımızda</a>
    <a href="/blog/">Blog</a>
  </nav>
  <p class="foot__end">© {year} · Harita verisi <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a></p>
</footer>
